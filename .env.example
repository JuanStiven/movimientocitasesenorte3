# Variables para docker-compose (los valores con :- son los defaults)
POSTGRES_DB=esenorte3_db
POSTGRES_USER=esenorte3_user
POSTGRES_PASSWORD=esenorte3_password

# URL pública del backend que usa el frontend (build arg).
# Local: http://localhost:8000  |  Producción (Coolify): https://api-<tu-app>.sslip.io o tu dominio
NEXT_PUBLIC_API_URL=http://localhost:8000
